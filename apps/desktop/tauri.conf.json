{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightHouse",
  "version": "0.1.0",
  "identifier": "com.lighthouse.controller",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir apps/desktop-ui build",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LightHouse",
        "width": 1600,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
