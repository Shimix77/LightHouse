{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lighthouse.local/schemas/fixture/v1/fixture.schema.json",
  "title": "LightHouse Canonical Fixture Definition v1",
  "type": "object",
  "required": ["id", "revision", "manufacturer", "model", "modes"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "manufacturer": { "type": "string" },
    "model": { "type": "string", "minLength": 1 },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "footprint", "parameters"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "footprint": { "type": "integer", "minimum": 1, "maximum": 512 },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "capability",
                "defaultValue",
                "binding",
                "invert"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "capability": {
                  "enum": [
                    "intensity",
                    "color",
                    "position",
                    "beam",
                    "shutter",
                    "gobo"
                  ]
                },
                "defaultValue": { "type": "number", "minimum": 0, "maximum": 1 },
                "binding": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["resolution", "offset"],
                      "properties": {
                        "resolution": { "const": "eightBit" },
                        "offset": { "type": "integer", "minimum": 0, "maximum": 511 }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["resolution", "coarse_offset", "fine_offset"],
                      "properties": {
                        "resolution": { "const": "sixteenBit" },
                        "coarse_offset": { "type": "integer", "minimum": 0, "maximum": 511 },
                        "fine_offset": { "type": "integer", "minimum": 0, "maximum": 511 }
                      }
                    }
                  ]
                },
                "invert": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
